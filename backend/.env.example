# Copier en .env pour le développement local.
# Sur Railway, ces variables se définissent dans l'onglet Variables du service.

NODE_ENV=development

# Ne PAS définir sur Railway : la plateforme injecte PORT elle-même.
PORT=3000

# Local   : conteneur Docker exposé sur le port 5433 (voir docker-compose.yml).
# Railway : ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://app:app@localhost:5433/app?schema=public"

# Origines autorisées par CORS, séparées par des virgules.
# À laisser vide en production : le front est servi par Express (même origine).
CORS_ORIGIN=http://localhost:5173
